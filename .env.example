# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Vision — Ultralytics weights path. If missing, contour fallback is used when enabled.
YOLO_FACE_WEIGHTS=/Users/mehdi/Desktop/computer_vision_cube_solver/runs/obb/rubik_cube_from_best/weights/best.pt
# detect = axis-aligned boxes | obb = oriented boxes (e.g. yolo26s-obb best.pt + class `face`)
# Example weights path below is under runs/obb/ — use obb, not detect.
YOLO_TASK=obb
# For OBB models: class index of `face` in your dataset yaml (default 0).
YOLO_OBB_FACE_CLASS_ID=0
YOLO_CONF_THRESHOLD=0.28
VISION_CONTOUR_FALLBACK=true
VISION_WARP_SIZE=360
# CORS origins (comma-separated), e.g. http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Frontend (Next.js): optional in dev — omit NEXT_PUBLIC_API_URL to use same-origin /cube-api proxy.
# NEXT_PUBLIC_API_URL=http://localhost:8000
